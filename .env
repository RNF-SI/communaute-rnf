# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices/configuration.html#infrastructure-related-configuration

###> RNF Authentication ###
# ⚠️ Valeur de PRODUCTION. Une préproduction doit pointer vers l'instance de
# test dans son .env.local — https://geonature-test.reserves-naturelles.org —
# sans quoi elle authentifie contre les comptes réels du réseau, et les comptes
# des données de test y répondent 401.
# RNF_AUTH_ID_APPLICATION peut différer d'une instance à l'autre.
RNF_AUTH_API_ENDPOINT=https://geonature.reserves-naturelles.org
RNF_AUTH_ID_APPLICATION=14
RNF_AUTH_APP_CODE=COMM_RNF
# Export GeoNature « Liens utilisateurs-réserves » (#28). Sans jeton, les
# réserves restent saisies à la main dans le profil.
RNF_EXPORT_TOKEN=
RNF_EXPORT_RESERVES_ID=3
###< RNF Authentication ###

###> symfony/framework-bundle ###
APP_ENV=dev
# APP_ENV=prod
# APP_DEBUG=0
APP_SECRET=0116ea354117af2c822bb1aeb5d7d367
#TRUSTED_PROXIES=127.0.0.1,127.0.0.2
#TRUSTED_HOSTS='^localhost|example\.com$'
SECURE_SCHEME=http
# Domaine utilisé pour bâtir les liens absolus hors requête HTTP, c'est-à-dire
# depuis les commandes console — le résumé quotidien des notifications, en
# particulier. Sans lui, tous les liens de ces e-mails pointent vers localhost.
SITE_HOST=localhost
# Adresse réelle vers laquelle diriger les comptes de test des fixtures, en
# préproduction. Renseignée, chaque compte reçoit une adresse étiquetée du type
# vous+admin@votredomaine.fr : tout arrive dans la même boîte, chaque compte
# reste distinguable, et rien ne rebondit. Laissée vide, les comptes de test
# restent en @example.org et n'envoient donc rien depuis un serveur.
TEST_ACCOUNTS_EMAIL=
# Autorise le chargement des fixtures dans un environnement « prod ». Une
# préproduction en a besoin, la PRODUCTION ne doit JAMAIS l'activer : charger
# les fixtures vide la base avant de la remplir.
ALLOW_FIXTURES=0

# Durée de la session, en secondes — c'est-à-dire la durée pendant laquelle on
# reste connecté. Toute l'authentification tient dans la session PHP : ni
# « remember me », ni jeton persistant, rien ne rattrape son expiration.
# 2592000 = 30 jours, repoussés à chaque page vue. Descendre en dessous de
# quelques heures, c'est déconnecter les gens en pleine rédaction.
SESSION_LIFETIME=2592000

# Connexion par mot de passe, en plus du SSO RNF. Nécessaire pour entrer avec
# les comptes des données de test, qui n'existent pas dans GeoNature.
# JAMAIS 1 en production.
FORM_LOGIN_ENABLED=0
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at http://docs.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# For an SQLite database, use: "sqlite:///%kernel.project_dir%/var/data.db"
# Configure your db driver and server_version in config/packages/doctrine.yaml
# For a MariaDB database, use: "mysql://db_user:db_password@127.0.0.1:3306/db_name?serverVersion=mariadb-10.3.22"
# DATABASE_URL=mysql://root:root@localhost:3306/dbname?serverVersion=5.7
DATABASE_PREFIX=communaute_rnf_
###< doctrine/doctrine-bundle ###

###> symfony/swiftmailer-bundle ###
# For Gmail as a transport, use: "gmail://username:password@localhost"
# For a generic SMTP server, use: "smtp://localhost:25?encryption=&auth_mode="
# Delivery is disabled by default via "null://localhost"
MAILER_URL=null://localhost
###< symfony/swiftmailer-bundle ###

# Defines plateform name
PLATEFORM_NAME="Communauté RNF"

# Defines default groups
COMMUNITY_SLUG=communaute
PLATEFORM_GROUP_SLUG=
# Defines mandatory informations pages
# e.g
# PLATFORM_CHARTER_PAGE_SLUG=charte-de-la-plateforme
# PLATFORM_CHARTER_PAGE_GROUP_SLUG=${COMMUNITY_SLUG}
# TERMS_OF_USE_PAGE_SLUG=mentions-legales
# TERMS_OF_USE_PAGE_GROUP_SLUG=${PLATEFORM_GROUP_SLUG}
# GROUP_CREATION_HELP_PAGE_SLUG=qui-peut-creer-des-groupes
# GROUP_CREATION_HELP_PAGE_GROUP_SLUG=${PLATEFORM_GROUP_SLUG}
# RESOURCES_PAGE_GROUP_SLUG=${COMMUNITY_SLUG}
# RESOURCES_PAGE_SLUG=ressources
PLATFORM_CHARTER_PAGE_SLUG=
PLATFORM_CHARTER_PAGE_GROUP_SLUG=
TERMS_OF_USE_PAGE_SLUG=
TERMS_OF_USE_PAGE_GROUP_SLUG=
GROUP_CREATION_HELP_PAGE_SLUG=
GROUP_CREATION_HELP_PAGE_GROUP_SLUG=
RESOURCES_PAGE_SLUG=
RESOURCES_PAGE_GROUP_SLUG=

# Defines Postmark credentials
POSTMARK_SENDER=
POSTMARK_SERVER_TOKEN=
POSTMARK_INBOUND_KEY=
POSTMARK_LIST_DOMAIN=rnfrance.org
# Jeton de SERVEUR Postmark, du même type que POSTMARK_SERVER_TOKEN : le flux
# « broadcast » est choisi par un en-tête, pas par le jeton. Les deux peuvent
# donc porter la même valeur. Vide = aucun e-mail de discussion, en silence.
POSTMARK_BULK_TOKEN=

###> OnlyOffice ###
# Édition en ligne des documents bureautiques (#43). Le serveur de documents
# est un service à part, à installer à côté de la plateforme — voir
# docs/edition-en-ligne.md. Vide, l'intégration est éteinte : aucun bouton
# n'apparaît, aucune route ne répond, et les documents se téléchargent comme
# avant. Les PDF, eux, s'affichent dans la page sans rien de tout ceci.
#
# Adresse à laquelle le NAVIGATEUR joint le serveur de documents. En https si
# la plateforme est en https, sans quoi le navigateur refuse le script.
ONLYOFFICE_URL=
# Secret partagé avec le serveur de documents (sa variable JWT_SECRET). Le
# laisser vide suppose un serveur configuré avec JWT_ENABLED=false, ce qui
# n'est raisonnable que s'il n'est joignable que depuis la machine.
ONLYOFFICE_JWT_SECRET=
# Adresse à laquelle LA PLATEFORME joint le serveur de documents, quand elle
# diffère de celle du navigateur. C'est le cas dès que les deux services
# partagent une seule adresse publique : de l'intérieur, joindre cette adresse
# revient à taper sur sa propre passerelle, et la plupart ne savent pas
# renvoyer le paquet vers l'intérieur. Symptôme : tout s'édite, rien ne
# s'enregistre. Exemple : http://10.0.20.44
ONLYOFFICE_INTERNAL_URL=
# Adresse à laquelle le SERVEUR DE DOCUMENTS joint la plateforme, quand elle
# diffère de celle du navigateur — un conteneur pour qui « localhost » désigne
# lui-même, typiquement. Vide, on garde l'hôte de la requête en cours.
# Exemple en développement : http://host.docker.internal:8000
ONLYOFFICE_PLATFORM_URL=
###< OnlyOffice ###

# Analytics feature flag
ANALYTICS_ENABLED=false

# TNTSearch parameters
INDEX_DIR='public/media/cache/indexes/'

# Admin module parameters
ASSET_DIR='public/media/layout/'
