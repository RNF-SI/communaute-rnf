{% extends 'base.html.twig' %}

{% block title %}{{ 'pages.group.groups.title'|trans }} | {{ plateform.name }}{% endblock %}

{% block main %}
	<section class="main main__groups-index">
		<div class="main--header main--header__cover">
			<div class="main--header--image">
				<img src="{{ path('app_image', {'tab': 'groups', 'image_type': 'frontgroup'}) }}" alt="">
			</div>
			<div class="main--header--content content-container">
				{% include 'components/app-flashes.html.twig' %}

				<div class="narrow">
					<h1 class="small-title">{{ 'pages.group.groups.title'|trans }}</h1>

					<p class="h1">{{ 'pages.group.groups.subtitle'|trans }}</p>

					<p>
						<a class="cta__white" href="{{ path('homepage') }}">{{ 'ui.see_more'|trans }}</a>
						{% if is_granted(constant('App\\Security\\GroupVoter::CREATE')) %}
							{# La classe sert de point d'accroche à la visite guidée (#39) #}
							<a class="cta__white groups-create-link" href="{{ path('group_new') }}">{{ 'pages.group.group_create.link'|trans }}</a>
						{% endif %}
					</p>
				</div>
			</div>
		</div>
		<div class="content-container">
			{% set displayableGroupsToActivate = user_group_relation.getGroupsUserCanAdmin(app.user, groupsToActivate) %}
			{% if groupsToActivate is defined and displayableGroupsToActivate is not empty %}
				<section class="groups-list groups-pending">
					<p class="small-title">
						{{ user_group_relation.isCommunityAdmin(app.user) ? 'pages.group.groups.list.pending.admins'|trans : 'pages.group.groups.list.pending.yours'|trans }}
						<span class="pending-groups-help" data-tooltip="{{ 'pages.group.groups.pending.info.description'|trans|default('Ces groupes ne sont pas indexés et n\'apparaissent pas dans les résultats de recherche tant qu\'ils ne sont pas validés par un administrateur.') }}">
							<img src="/media/layout/help.svg" alt="?" style="width: 16px; height: 16px; margin-left: 8px; vertical-align: middle;">
						</span>
					</p>
					<ul id="groups-to-activate-elements">
						{% for groupToActivate in displayableGroupsToActivate %}
							<li>
								{% include 'contents/group/group--teaser.html.twig' with {'group':groupToActivate} %}
							</li>
						{% endfor %}
					</ul>
				</section>
				
				<hr class="groups-separator" style="margin: 40px 0; border: 0; border-top: 2px solid #e0e0e0;">
			{% endif %}

			<section class="groups-list groups-active">
				<div class="groups-header">
					<p class="small-title">{{ 'pages.group.groups.list.active'|trans|default('Groupes actifs') }}</p>
					<div class="groups-view-toggle">
						<button id="list-view-btn" class="view-toggle-btn active">
							<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
								<path d="M2 4h12v1H2V4zm0 3h12v1H2V7zm0 3h12v1H2v-1z"/>
							</svg>
							Liste
						</button>
						<button id="graph-view-btn" class="view-toggle-btn">
							<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
								<circle cx="3" cy="3" r="2"/>
								<circle cx="13" cy="3" r="2"/>
								<circle cx="8" cy="13" r="2"/>
								<line x1="5" y1="3" x2="11" y2="3" stroke="currentColor" stroke-width="1"/>
								<line x1="3" y1="5" x2="6" y2="11" stroke="currentColor" stroke-width="1"/>
								<line x1="13" y1="5" x2="10" y2="11" stroke="currentColor" stroke-width="1"/>
							</svg>
							Graphique
						</button>
					</div>
				</div>
				
				<div id="search-container" class="group-search-bar">
					{{ form_widget(form.groups_search_bar, {'attr': {'placeholder': 'Rechercher'}}) }}

					{% if (parents is defined and parents is not empty)
						or (categories is defined and categories is not empty) %}
						<form method="get" class="groups-filter" id="groups-filter">
							{% if parents is defined and parents is not empty %}
								<label for="groups-filter-commission">{{ 'pages.group.groups.filter.label'|trans }}</label>
								<select id="groups-filter-commission" name="commission">
									<option value="">{{ 'pages.group.groups.filter.all'|trans }}</option>
									{% for parent in parents %}
										<option value="{{ parent.slug }}"
												{{ selectedCommission == parent.slug ? 'selected' : '' }}>{{ parent.name }}</option>
									{% endfor %}
								</select>
							{% endif %}

							{# Le second axe : de quoi le groupe parle, quelle que soit la
							   commission dont il dépend. Absent tant qu'aucun groupe n'est
							   classé. (#23) #}
							{% if categories is defined and categories is not empty %}
								<label for="groups-filter-theme">{{ 'pages.group.groups.filter.theme_label'|trans }}</label>
								<select id="groups-filter-theme" name="theme">
									<option value="">{{ 'pages.group.groups.filter.theme_all'|trans }}</option>
									{% for category in categories %}
										<option value="{{ category.slug }}"
												{{ selectedTheme == category.slug ? 'selected' : '' }}>{{ category.name }}</option>
									{% endfor %}
								</select>
							{% endif %}

							<noscript><button type="submit">{{ 'pages.group.groups.filter.submit'|trans }}</button></noscript>
						</form>
					{% endif %}
				</div>
				
				<div id="list-view" class="groups-view">
					<div id="all-groups-container">
						{% include 'pages/group/groups-list.html.twig' with {'groups': groups, 'groups_tree': groupsTree} %}
					</div>
				</div>
				
				<div id="graph-view" class="groups-view" style="display: none;">
					<div class="groups-visualization">
						<div id="groups-graph" class="groups-graph">
							<div class="loading">
								<div class="spinner"></div>
								<p>Chargement de la visualisation...</p>
							</div>
						</div>
						
						<div class="graph-bottom-controls">
							<button id="center-graph" class="btn btn--secondary">Centrer le graphique</button>
						</div>
						
						<div class="legend">
							<h3>Légende</h3>
							<div class="legend-item">
								<div class="legend-circle legend-circle--important"></div>
								<span>Groupes importants</span>
							</div>
							<div class="legend-item">
								<div class="legend-circle legend-circle--normal"></div>
								<span>Groupes standard</span>
							</div>
							<div class="legend-item">
								<div class="legend-line"></div>
								<span>Relations parent-enfant</span>
							</div>
						</div>
						
						<div id="node-tooltip" class="node-tooltip" style="display: none;">
							<h4 class="tooltip-title"></h4>
							<p class="tooltip-description"></p>
							<div class="tooltip-stats">
								<span class="member-count"></span>
								<span class="visibility"></span>
							</div>
						</div>
					</div>
				</div>
			</section>
		</div>
	</section>
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	{{ encore_entry_link_tags('groups-visualization') }}
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	{{ encore_entry_script_tags('groups-visualization') }}
	<script>
		document.addEventListener('DOMContentLoaded', function() {
			const listViewBtn = document.getElementById('list-view-btn');
			const graphViewBtn = document.getElementById('graph-view-btn');
			const listView = document.getElementById('list-view');
			const graphView = document.getElementById('graph-view');
			
			let visualizationLoaded = false;
			
			function switchToListView() {
				listViewBtn.classList.add('active');
				graphViewBtn.classList.remove('active');
				listView.style.display = 'block';
				graphView.style.display = 'none';
				document.getElementById('search-container').style.display = 'block';
			}
			
			function switchToGraphView() {
				listViewBtn.classList.remove('active');
				graphViewBtn.classList.add('active');
				listView.style.display = 'none';
				graphView.style.display = 'block';
				document.getElementById('search-container').style.display = 'none';
				
				// Charger la visualisation seulement quand nécessaire
				if (!visualizationLoaded) {
					// Créer une instance de GroupsVisualization directement
					if (window.GroupsVisualization) {
						window.currentVisualization = new window.GroupsVisualization();
						visualizationLoaded = true;
					}
				}
			}
			
			listViewBtn.addEventListener('click', switchToListView);
			graphViewBtn.addEventListener('click', switchToGraphView);
		});
	</script>
{% endblock %}
