{# Les dossiers sont repliés par défaut : dans un groupe qui range bien, la
   page s'ouvrait sur tous les documents de tous les dossiers, et l'on
   cherchait le dossier voulu au milieu de leur contenu. (#42)

   `<details>` natif : il se déplie sans JavaScript, au clavier, et dit
   lui-même aux lecteurs d'écran s'il est ouvert. Une recherche ou un filtre
   en cours déplie tout (`unfolded`). #}
{% macro folder(node, depth, group, unfolded) %}
	{% import _self as tree %}
	<details class="documents-folder documents-folder__depth-{{ depth }}"{{ unfolded ? ' open' : '' }}>
		<summary class="documents-folder--name">
			<span class="documents-folder--title">{{ node.folder.title }}</span>
			<span class="documents-folder--count">{{ 'pages.document.list.folder_count'|trans({'%count%': node.count}) }}</span>
		</summary>
		{% if node.documents is not empty %}
			<ul class="documents-list">
				{% for document in node.documents %}
					<li>
						{% include 'contents/document/document--teaser.html.twig' with {'document':document, 'group':group} %}
					</li>
				{% endfor %}
			</ul>
		{% endif %}
		{% for child in node.children %}
			{{ tree.folder(child, depth + 1, group, unfolded) }}
		{% endfor %}
	</details>
{% endmacro %}

{% extends 'base.html.twig' %}
{% import _self as tree %}

{% block title %}{{ 'pages.document.list.title'|trans }} - {{ group.name }} | {{ plateform.name }}{% endblock %}

{% block main %}
	<section class="main main__documents-index">
		<div class="main--content content-container">
			{% include 'components/app-flashes.html.twig' %}

			<div class="panel">
				<h1 class="h1">{{ 'pages.document.list.title'|trans }}</h1>

				{% if is_granted(constant('App\\Security\\GroupDocumentVoter::CREATE'), group) %}
					<div class="panel--edit">
						<a class="cta__inverted" href="{{ path('group_document_new', {'groupSlug':group.slug}) }}">{{ 'pages.document.document_create.link'|trans }}</a>
					</div>
				{% endif %}
			</div>

			{% include 'components/permission-note.html.twig' with {'group': group, 'label': 'pages.document.list.rights'} %}

			{% include 'components/breadcrumb.html.twig' with {'items':[
				{
					label: 'pages.group.groups.title'|trans,
					href: path('groups_index')
				},
				{
					label: group.name,
					href: path('group_index', {'groupSlug':group.slug})
				},
				{
					label: 'pages.group.documents.title'|trans,
				}
			]} %}

			{{ form_start(form) }}
			<div class="columns__33-66 columns__no-stretch">
				<div class="filters">
					<div class="small-title">{{ 'pages.document.list.filters.title'|trans }}</div>
					<div class="form-row form-row__filter">
						{{ form_label(form.filetype, 'pages.document.list.filters.filetype.label') }}
						<div class="form-row__checkboxes">
							{{ form_widget(form.filetype) }}
						</div>
					</div>
					{% if form.tags|length > 0 %}
						<div class="form-row form-row__filter">
							{{ form_label(form.tags, 'pages.document.list.filters.tags.label') }}
							<div class="form-row__checkboxes">
								{{ form_widget(form.tags) }}
							</div>
						</div>
					{% endif %}
					<div class="form-row form-row__submit">
						{{ form_widget(form.submit, {'label': 'pages.document.list.search'}) }}
					</div>
				</div>
				<div>
					<div class="form-row form-row__no-gap">
						{{ form_widget(form.query, {'attr': {'placeholder': 'pages.document.list.query.placeholder'}}) }}
					</div>
					{% if documents is not empty %}
						<ul class="documents-list">
							{% for document in documents %}
								<li>
									{% include 'contents/document/document--teaser.html.twig' with {'document':document} %}
								</li>
							{% endfor %}
						</ul>
					{% endif %}
					{% for node in folders %}
						{{ tree.folder(node, 0, group, unfolded) }}
					{% endfor %}
					{% include 'components/pager.html.twig' %}
				</div>
			</div>
			{{ form_end(form) }}
		</div>
	</section>
{% endblock %}
