{% extends 'base.html.twig' %}

{% block title %}{{ document.title }} - {{ group.name }} | {{ plateform.name }}{% endblock %}

{% block main %}
	<section class="main main__document-index">
		<div class="main--content content-container">
			{% include 'components/app-flashes.html.twig' %}

			<div class="panel">
				<h1 class="h1">{{ document.title }}</h1>

				<div class="panel--edit">
					{# L'éditeur en ligne d'abord quand il est disponible : c'est le
					   geste utile — le téléchargement reste à côté, et reste un
					   téléchargement (`download`), y compris pour un PDF que la page
					   sait pourtant afficher. (#43) #}
					{% if office and app.user %}
						<a class="cta" href="{{ path('group_document_office', {'groupSlug': group.slug, 'documentId': document.id}) }}">
							{{ (officeEdit ? 'pages.document.view.office.edit' : 'pages.document.view.office.open')|trans }}
						</a>
					{% endif %}
					{% if document.file %}
						<a class="{{ (office and app.user) ? 'cta__inverted' : 'cta' }}" href="{{ path('group_document_get', {'groupSlug': group.slug, 'documentId': document.id, 'download': 1}) }}">{{ 'pages.document.view.download'|trans }}</a>
					{% endif %}
					{% if is_granted(constant('App\\Security\\GroupDocumentVoter::EDIT'), document) %}
						<a class="cta__inverted" href="{{ path('group_document_edit', {'groupSlug': group.slug, 'documentId': document.id}) }}">{{ 'pages.document.document_edit.link'|trans }}</a>
					{% endif %}
				</div>
			</div>

			{% include 'components/breadcrumb.html.twig' with {'items':[
				{
					label: 'pages.group.groups.title'|trans,
					href: path('groups_index')
				},
				{
					label: group.name,
					href: path('group_index', {'groupSlug':group.slug})
				},
				{
					label: 'pages.group.documents.title'|trans,
					href: path('group_documents_index', {'groupSlug':group.slug})
				},
				{
					label: document.title,
				}
			]} %}

			<div class="thin">
				{# Le document lui-même, avant tout ce qu'on en dit. (#43)

				   Un PDF s'affiche dans une `iframe` — le lecteur du navigateur,
				   rien d'installé, rien chargé chez un tiers, et le document
				   reste servi par notre route, donc derrière le voteur. Une image
				   s'affiche telle quelle. Ce qui n'est ni l'un ni l'autre n'a pas
				   d'aperçu : mieux vaut le bouton d'édition en ligne juste
				   au-dessus qu'une page d'octets. #}
				{% if preview == 'pdf' %}
					<figure class="document-preview">
						<iframe class="document-preview--frame"
								src="{{ path('group_document_get', {'groupSlug': group.slug, 'documentId': document.id}) }}"
								title="{{ document.title }}"
								loading="lazy"></iframe>
						{# Un navigateur sans lecteur intégré n'affiche rien du tout et
						   ne le dit pas : la légende porte donc toujours la sortie de
						   secours. #}
						<figcaption class="document-preview--fallback">
							{{ 'pages.document.view.preview.fallback'|trans }}
							<a href="{{ path('group_document_get', {'groupSlug': group.slug, 'documentId': document.id, 'download': 1}) }}">{{ 'pages.document.view.preview.download'|trans }}</a>
						</figcaption>
					</figure>
				{% elseif preview == 'image' %}
					<figure class="document-preview document-preview__image">
						<a href="{{ path('group_document_get', {'groupSlug': group.slug, 'documentId': document.id}) }}">
							<img src="{{ path('group_document_get', {'groupSlug': group.slug, 'documentId': document.id}) }}"
								 alt="{{ document.title }}"
								 loading="lazy">
						</a>
					</figure>
				{% endif %}

				{# Ce qu'est le document, puis ce qui en a été dit : deux cartes, et
				   non deux blocs posés à plat sur le fond de page. Sans le fond
				   blanc, la liste de liens du bas se lisait comme la suite des
				   métadonnées du haut, et les étiquettes — gris pâle sur gris pâle —
				   disparaissaient. (#32) #}
				<article class="document-sheet">
					{% if document.description is not empty %}
						<p class="document-sheet--description">{{ document.description|nl2br }}</p>
					{% endif %}

					{% if document.tags is not empty %}
						<ul class="document-sheet--tags">
							{% for tag in document.tags %}
								<li>
									<a href="{{ path('group_documents_index', {'groupSlug': group.slug, 'form': {'tags': [tag.id]}}) }}">{{ tag.name }}</a>
								</li>
							{% endfor %}
						</ul>
					{% endif %}

					<dl class="document-sheet--facts">
						{% if document.folder %}
							<dt>{{ 'pages.document.view.folder'|trans }}</dt>
							<dd>{{ document.folder.path }}</dd>
						{% endif %}

						{% if document.user %}
							<dt>{{ 'pages.document.view.author'|trans }}</dt>
							<dd><a href="{{ path('member', {'user_id': document.user.id}) }}">{{ document.user.name }}</a></dd>
						{% endif %}

						<dt>{{ 'pages.document.view.added'|trans }}</dt>
						<dd>{{ document.createdAt|localizeddate('long', 'none', app.request.locale) }}</dd>

						{% if size %}
							<dt>{{ 'pages.document.view.size'|trans }}</dt>
							<dd>{{ size }}</dd>
						{% endif %}
					</dl>

					{% if document.file is empty %}
						<p class="document-sheet--nofile">{{ 'pages.document.view.no_file'|trans }}</p>
					{% endif %}
				</article>

				{# Ce qui a été dit de ce document, et les pages qui s'y réfèrent :
				   c'est la moitié manquante de la navigation, celle qui va du
				   document vers le reste. (#32)

				   Chacune des deux listes porte son intertitre. Seules les pages en
				   avaient un, si bien que « Pages qui y renvoient » semblait
				   qualifier la discussion posée juste au-dessus. #}
				<section class="document-talk">
					<div class="document-talk--head">
						<h2 class="h3">{{ 'pages.document.view.talk.title'|trans }}</h2>

						{% if is_granted(constant('App\\Security\\GroupDiscussionVoter::CREATE'), group) %}
							<a class="cta__inverted document-talk--ask"
							   href="{{ path('group_discussion_new', {'groupSlug': group.slug, 'document': document.id}) }}">{{ 'pages.document.view.talk.ask'|trans }}</a>
						{% endif %}
					</div>

					{% if discussions is empty and pages is empty %}
						<p class="document-talk--empty">{{ 'pages.document.view.talk.empty'|trans }}</p>
					{% endif %}

					{% if discussions is not empty %}
						<h3 class="document-talk--kind">{{ 'pages.document.view.talk.discussions'|trans }}</h3>
						<ul class="document-talk--list">
							{% for discussion in discussions %}
								<li>
									<a class="document-talk--item" href="{{ path('group_discussion_index', {'groupSlug': group.slug, 'discussionUuid': discussion.uuid}) }}">
										<span class="document-talk--item-title">{{ discussion.title }}</span>
									</a>
								</li>
							{% endfor %}
						</ul>
					{% endif %}

					{% if pages is not empty %}
						<h3 class="document-talk--kind">{{ 'pages.document.view.talk.pages'|trans }}</h3>
						<ul class="document-talk--list">
							{% for page in pages %}
								<li>
									<a class="document-talk--item" href="{{ path('group_page_index', {'groupSlug': group.slug, 'pageSlug': page.slug}) }}">
										<span class="document-talk--item-title">{{ page.title }}</span>
									</a>
								</li>
							{% endfor %}
						</ul>
					{% endif %}
				</section>
			</div>
		</div>
	</section>
{% endblock %}
