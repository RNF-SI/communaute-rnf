{% extends 'base.html.twig' %}

{% block title %}{{ 'pages.user.parameters_edit.title'|trans }} | {{ plateform.name }}{% endblock %}

{% block main %}
    <section class="main main__user-page main__user-page__parameters">
        <div class="main--content content-container">
            <div class="thin">
                {% include 'components/app-flashes.html.twig' %}

                <section>
                    <div class="panel">
                        <h1 class="h1">{{ 'pages.user.parameters_edit.title'|trans }}</h1>
                    </div>
                </section>

                <section class="profile-form notifications-settings" id="notifications-settings">
                    <h2 class="h2">{{ 'pages.user.notifications_settings.title'|trans }}</h2>
                    <p>{{ 'pages.user.notifications_settings.introduction'|trans }}</p>
                    <p class="hint">{{ 'pages.user.notifications_settings.rhythm_hint'|trans }}</p>

                    <form method="post">
                        <input type="hidden" name="_token" value="{{ csrf_token('notifications') }}">

                        <div class="form-row form-row__field">
                            <label>
                                <input type="checkbox" name="notifications[emails]" value="1"
                                       {{ user.wantsEmails ? 'checked' : '' }}>
                                {{ 'pages.user.notifications_settings.emails'|trans }}
                            </label>
                            <div class="hint">{{ 'pages.user.notifications_settings.emails_hint'|trans }}</div>
                        </div>

                        {# Le réglage général : ce que vaut un groupe qui ne
                           dit rien de particulier. Quelqu'un qui siège dans
                           trente groupes le règle une fois ici au lieu de le
                           recopier trente fois plus bas. #}
                        <h3 class="h3">{{ 'pages.user.notifications_settings.general'|trans }}</h3>
                        <p class="hint">{{ 'pages.user.notifications_settings.general_hint'|trans }}</p>

                        {# La boîte aux lettres. Fermer n'interrompt pas les
                           conversations en cours : on y répond encore, on n'en
                           reçoit simplement plus de nouvelles. #}
                        <div class="form-row form-row__field">
                            <label>
                                <input type="checkbox" name="notifications[messagesOpen]" value="1"
                                       {{ user.isMessagesOpen ? 'checked' : '' }}>
                                {{ 'pages.user.notifications_settings.messages_open'|trans }}
                            </label>
                            <div class="hint">{{ 'pages.user.notifications_settings.messages_open_hint'|trans }}</div>
                        </div>

                        <div class="notifications-settings--defaults">
                            {% for category in generalCategories %}
                                <div class="form-row form-row__field">
                                    <label for="notif-default-{{ category }}">
                                        {{ ('pages.user.notifications_settings.categories.' ~ category)|trans }}
                                    </label>
                                    <select id="notif-default-{{ category }}"
                                            name="notifications[defaults][{{ category }}]">
                                        {% for level in levels %}
                                            <option value="{{ level }}"
                                                    {{ user.getDefaultNotificationLevel(category) == level ? 'selected' : '' }}>
                                                {{ ('pages.user.notifications_settings.levels.' ~ level)|trans }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                            {% endfor %}
                        </div>

                        <h3 class="h3">{{ 'pages.user.notifications_settings.groups'|trans }}</h3>
                        <p class="hint">{{ 'pages.user.notifications_settings.groups_hint'|trans }}</p>

                        <div class="notifications-settings--list"
                             data-filter-label="{{ 'pages.user.notifications_settings.filter'|trans }}"
                             data-count-label="{{ 'pages.user.notifications_settings.count'|trans }}"
                             data-follow-label="{{ 'pages.user.notifications_settings.follow_this_group'|trans }}"
                             data-follows-label="{{ 'pages.user.notifications_settings.follows_general'|trans }}"
                             data-empty-label="{{ 'pages.user.notifications_settings.no_match'|trans }}">
                            {% for membership in user.usergroupMemberships %}
                                {% if membership.usergroup and membership.usergroup.isActive %}
                                    {% set group = membership.usergroup %}
                                    {# Ce que le groupe dit de lui-même, calculé côté PHP :
                                       accumuler dans une boucle Twig ne survivrait pas à
                                       la boucle. #}
                                    {% set apart = membership.ownNotificationLevels %}

                                    <details class="notifications-settings--group" data-name="{{ group.name }}">
                                        <summary>
                                            <span class="notifications-settings--group-name">{{ group.name }}</span>
                                            <span class="notifications-settings--group-state{{ membership.followsGeneralSettings ? '' : ' notifications-settings--group-state__apart' }}">
                                                {%- if apart is empty -%}
                                                    {{ 'pages.user.notifications_settings.follows_general'|trans }}
                                                {%- else -%}
                                                    {%- for category, own in apart -%}
                                                        {{- ('pages.user.notifications_settings.categories.' ~ category)|trans }} : {{ ('pages.user.notifications_settings.levels.' ~ own)|trans|lower -}}
                                                        {{- loop.last ? '' : ' · ' -}}
                                                    {%- endfor -%}
                                                {%- endif -%}
                                            </span>
                                        </summary>

                                        {% for category in categories %}
                                            <div class="form-row form-row__field">
                                                <label for="notif-{{ group.id }}-{{ category }}">
                                                    {{ ('pages.user.notifications_settings.categories.' ~ category)|trans }}
                                                </label>
                                                <select id="notif-{{ group.id }}-{{ category }}"
                                                        name="notifications[groups][{{ group.id }}][{{ category }}]">
                                                    <option value="">{{ 'pages.user.notifications_settings.same_as_general'|trans }}</option>
                                                    {% for level in levels %}
                                                        <option value="{{ level }}"
                                                                {{ membership.getOwnNotificationLevel(category) == level ? 'selected' : '' }}>
                                                            {{ ('pages.user.notifications_settings.levels.' ~ level)|trans }}
                                                        </option>
                                                    {% endfor %}
                                                </select>
                                            </div>
                                        {% endfor %}
                                    </details>
                                {% endif %}
                            {% endfor %}
                        </div>

                        <div class="form-row form-row__submit">
                            <button type="submit" class="cta">{{ 'pages.user.notifications_settings.submit'|trans }}</button>
                            {# Rattraper trente groupes réglés un par un : le
                               seul geste que les listes ci-dessus ne savent
                               pas faire d'un coup. #}
                            <button type="submit" name="reset-groups" value="1" class="cta__inverted"
                                    data-confirm-message="{{ 'pages.user.notifications_settings.reset_confirm'|trans }}">
                                {{ 'pages.user.notifications_settings.reset'|trans }}
                            </button>
                        </div>
                    </form>
                </section>

                {# Revoir la visite guidée : elle ne se relance plus d'elle-même
                   une fois vue, c'est ici qu'on la redemande. (#39) #}
                <section class="profile-form">
                    <h2 class="h2">{{ 'pages.tour.replay'|trans }}</h2>
                    <p>
                        <a class="cta__inverted tour-replay" href="{{ path('user_tour') }}">{{ 'pages.tour.replay'|trans }}</a>
                    </p>
                </section>

                <section class="profile-form">
                    {% include 'forms/user/delete-user-form.html.twig' %}
                </section>
            </div>
        </div>
    </section>
{% endblock %}