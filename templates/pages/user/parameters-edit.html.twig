{% extends 'base.html.twig' %}

{% block title %}{{ 'pages.user.parameters_edit.title'|trans }} | {{ plateform.name }}{% endblock %}

{% block main %}
    <section class="main main__user-page main__user-page__parameters">
        <div class="main--content content-container">
            <div class="thin">
                {% include 'components/app-flashes.html.twig' %}

                <section>
                    <div class="panel">
                        <h1 class="h1">{{ 'pages.user.parameters_edit.title'|trans }}</h1>
                    </div>
                </section>

                <section class="profile-form notifications-settings" id="notifications-settings">
                    <h2 class="h2">{{ 'pages.user.notifications_settings.title'|trans }}</h2>
                    <p>{{ 'pages.user.notifications_settings.introduction'|trans }}</p>

                    <form method="post">
                        <input type="hidden" name="_token" value="{{ csrf_token('notifications') }}">

                        <div class="form-row form-row__field">
                            <label>
                                <input type="checkbox" name="notifications[emails]" value="1"
                                       {{ user.wantsEmails ? 'checked' : '' }}>
                                {{ 'pages.user.notifications_settings.emails'|trans }}
                            </label>
                            <div class="hint">{{ 'pages.user.notifications_settings.emails_hint'|trans }}</div>
                        </div>

                        <div class="form-row form-row__field">
                            <label for="discussion-rhythm">{{ 'pages.user.notifications_settings.rhythm'|trans }}</label>
                            <select id="discussion-rhythm" name="notifications[discussionRhythm]">
                                {% for rhythm in rhythms %}
                                    <option value="{{ rhythm }}"
                                            {{ user.discussionEmailRhythm == rhythm ? 'selected' : '' }}>
                                        {{ ('pages.user.notifications_settings.rhythms.' ~ rhythm)|trans }}
                                    </option>
                                {% endfor %}
                            </select>
                            <div class="hint">{{ 'pages.user.notifications_settings.rhythm_hint'|trans }}</div>
                        </div>

                        <h3 class="h3">{{ 'pages.user.notifications_settings.groups'|trans }}</h3>

                        {% for membership in user.usergroupMemberships %}
                            {% if membership.usergroup and membership.usergroup.isActive %}
                                <fieldset class="notifications-settings--group">
                                    <legend>{{ membership.usergroup.name }}</legend>

                                    {% for category in categories %}
                                        <div class="form-row form-row__field">
                                            <label for="notif-{{ membership.usergroup.id }}-{{ category }}">
                                                {{ ('pages.user.notifications_settings.categories.' ~ category)|trans }}
                                            </label>
                                            <select id="notif-{{ membership.usergroup.id }}-{{ category }}"
                                                    name="notifications[groups][{{ membership.usergroup.id }}][{{ category }}]">
                                                {% for level in levels %}
                                                    <option value="{{ level }}"
                                                            {{ membership.getNotificationLevel(category) == level ? 'selected' : '' }}>
                                                        {{ ('pages.user.notifications_settings.levels.' ~ level)|trans }}
                                                    </option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                    {% endfor %}
                                </fieldset>
                            {% endif %}
                        {% endfor %}

                        <div class="form-row form-row__submit">
                            <button type="submit" class="cta">{{ 'pages.user.notifications_settings.submit'|trans }}</button>
                        </div>
                    </form>
                </section>

                {# Revoir la visite guidée : elle ne se relance plus d'elle-même
                   une fois vue, c'est ici qu'on la redemande. (#39) #}
                <section class="profile-form">
                    <h2 class="h2">{{ 'pages.tour.replay'|trans }}</h2>
                    <p>
                        <a class="cta__inverted tour-replay" href="{{ path('user_tour') }}">{{ 'pages.tour.replay'|trans }}</a>
                    </p>
                </section>

                <section class="profile-form">
                    {% include 'forms/user/delete-user-form.html.twig' %}
                </section>
            </div>
        </div>
    </section>
{% endblock %}