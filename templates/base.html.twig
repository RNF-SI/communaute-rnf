<!DOCTYPE html>
<html lang="{{ app.request ? app.request.locale : 'fr' }}">

<head>
	<meta charset="utf-8"/>
	<title>{% block title %}{{ plateform.name }}{% endblock %}</title>
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	{% block favicon %}
		<link rel="manifest" href="/site.webmanifest">
		<meta name="msapplication-config" content="/media/favicon/browserconfig.xml">

		<link rel="shortcut icon" href="/media/favicon/favicon.ico">
		<link rel="apple-touch-icon" sizes="180x180" href="/media/favicon/apple-touch-icon.png">
		<link rel="icon" type="image/png" sizes="32x32" href="/media/favicon/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/media/favicon/favicon-16x16.png">
		<link rel="mask-icon" href="/media/favicon/safari-pinned-tab.svg" color="#0B885D">

		{# La couleur de la barre du navigateur sur mobile : le vert de la charte,
		   pas le blanc par défaut du générateur de favicons. #}
		<meta name="theme-color" content="#0B885D">
	{% endblock %}
	{% block stylesheets %}
		{# Les fontes sont servies depuis le domaine (voir _config/_font-faces).
		   Le <link> qui se trouvait ici allait chercher Open Sans chez Google —
		   une famille appelée nulle part dans le CSS, donc une requête tierce
		   bloquante et une adresse IP déposée chez un tiers, pour rien.

		   Les deux fichiers préchargés sont ceux dont *toute* page a besoin :
		   le texte courant et les titres, sous-ensemble latin. `crossorigin`
		   est obligatoire même en même origine, les fontes étant toujours
		   chargées en mode CORS. #}
		<link rel="preload" href="{{ asset('build/fonts/jost/jost-latin.woff2') }}" as="font" type="font/woff2" crossorigin>
		<link rel="preload" href="{{ asset('build/fonts/arima/arima-madurai-700-latin.woff2') }}" as="font" type="font/woff2" crossorigin>
		{{ encore_entry_link_tags('app') }}
	{% endblock %}
	{% if plateform.analytics %}
	<script async defer data-domain="communaute-rnf.fr" src="https://ping.communaute-rnf.fr/js/index.js"></script>
	{% endif %}
</head>

<body>
{% include 'layout/icons.svg.twig' %}

{# Passer l'en-tête et le menu d'un coup. Invisible à la souris, premier
   élément atteint au clavier. #}
<a class="skip-link" href="#contenu">{{ 'ui.skip_to_content'|trans }}</a>

{% block header %}
	{% include 'layout/header.html.twig' %}
{% endblock %}

{# Ce qui a changé dans les notifications, dit une fois à ceux que le
   changement concerne. (#38) #}
{% include 'components/notifications-notice.html.twig' %}

<main id="contenu" tabindex="-1">
	{% block main %}
		<section class="main">
			<div class="main--header">
				<div class="main--header--image">
					<!-- Hero image here -->
				</div>
				<div class="main--header--content content-container">
					{% include 'components/app-flashes.html.twig' %}
				</div>
			</div>
			<div class="main--content content-container">
				<!-- Page content here -->
			</div>
		</section>
	{% endblock %}
</main>

{% block footer %}
	{% include 'layout/footer.html.twig' %}
{% endblock %}

{# La visite guidée : rendue seulement quand elle a lieu d'être, c'est-à-dire
   tant qu'elle n'a pas été vue, ou quand on la redemande. (#39) #}
{% set tourSteps = guided_tour() %}
{% if tourSteps is not empty %}
	<div id="guided-tour"
		 data-steps="{{ tourSteps|json_encode|escape('html_attr') }}"
		 data-seen-url="{{ path('user_tour_seen') }}"
		 data-token="{{ csrf_token('guided-tour') }}"
		 data-labels="{{ {
			 'next': 'pages.tour.next'|trans,
			 'previous': 'pages.tour.previous'|trans,
			 'close': 'pages.tour.close'|trans,
			 'end': 'pages.tour.end'|trans,
			 'skip': 'pages.tour.skip'|trans,
			 'resume': 'pages.tour.resume'|trans,
			 'progress': 'pages.tour.progress'|trans
		 }|json_encode|escape('html_attr') }}"></div>
{% endif %}

{% block javascripts %}
	{{ encore_entry_script_tags('app') }}
{% endblock %}

</body>

</html>
