<!DOCTYPE html>
<html>

<head>
	<meta charset="utf-8"/>
	<title>{% block title %}{{ plateform.name }}{% endblock %}</title>
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	{% block favicon %}
		<link rel="manifest" href="/site.webmanifest">
		<meta name="msapplication-config" content="/media/favicon/browserconfig.xml">

		<link rel="shortcut icon" href="/media/favicon/favicon.ico">
		<link rel="apple-touch-icon" sizes="180x180" href="/media/favicon/apple-touch-icon.png">
		<link rel="icon" type="image/png" sizes="32x32" href="/media/favicon/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/media/favicon/favicon-16x16.png">
		<link rel="mask-icon" href="/media/favicon/safari-pinned-tab.svg" color="#ffffff">

		<meta name="theme-color" content="#ffffff">
	{% endblock %}
	{% block stylesheets %}
	<link href="https://fonts.googleapis.com/css?family=Open+Sans:400,400i,600,600i" rel="stylesheet">
		{{ encore_entry_link_tags('app') }}
	{% endblock %}
	{% if plateform.analytics %}
	<script async defer data-domain="communaute-rnf.fr" src="https://ping.communaute-rnf.fr/js/index.js"></script>
	{% endif %}
</head>

<body>
{% include 'layout/icons.svg.twig' %}

{% block header %}
	{% include 'layout/header.html.twig' %}
{% endblock %}

{# Ce qui a changé dans les notifications, dit une fois à ceux que le
   changement concerne. (#40) #}
{% include 'components/notifications-notice.html.twig' %}

<main>
	{% block main %}
		<section class="main">
			<div class="main--header">
				<div class="main--header--image">
					<!-- Hero image here -->
				</div>
				<div class="main--header--content content-container">
					{% include 'components/app-flashes.html.twig' %}
				</div>
			</div>
			<div class="main--content content-container">
				<!-- Page content here -->
			</div>
		</section>
	{% endblock %}
</main>

{% block footer %}
	{% include 'layout/footer.html.twig' %}
{% endblock %}

{# La visite guidée : rendue seulement quand elle a lieu d'être, c'est-à-dire
   tant qu'elle n'a pas été vue, ou quand on la redemande. (#39) #}
{% set tourSteps = guided_tour() %}
{% if tourSteps is not empty %}
	<div id="guided-tour"
		 data-steps="{{ tourSteps|json_encode|escape('html_attr') }}"
		 data-seen-url="{{ path('user_tour_seen') }}"
		 data-token="{{ csrf_token('guided-tour') }}"
		 data-labels="{{ {
			 'next': 'pages.tour.next'|trans,
			 'previous': 'pages.tour.previous'|trans,
			 'close': 'pages.tour.close'|trans,
			 'end': 'pages.tour.end'|trans,
			 'skip': 'pages.tour.skip'|trans,
			 'resume': 'pages.tour.resume'|trans,
			 'progress': 'pages.tour.progress'|trans
		 }|json_encode|escape('html_attr') }}"></div>
{% endif %}

{% block javascripts %}
	{{ encore_entry_script_tags('app') }}
{% endblock %}

</body>

</html>
