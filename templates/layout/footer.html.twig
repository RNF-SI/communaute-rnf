<footer class="footer">
	<div class="content-container">
		<div class="footer--logo">
			<p class="plateform-logo">
				<img src="{{ asset('media/layout/logo-rnf-footer.png') }}" alt="{{ plateform.name }}">
			</p>
		</div>
		<div class="footer--menu">
			<ul>
				{% set appFooterFirstMenus = render(controller( 'App\\Controller\\AppController::appFooterMenus', {'position': 'first'} )) %}
				{% set appFooterSecondMenus = render(controller( 'App\\Controller\\AppController::appFooterMenus', {'position': 'second'} )) %}
				{% set appFooterThirdMenus = render(controller( 'App\\Controller\\AppController::appFooterMenus', {'position': 'third'} )) %}
				{% set appFooterPlatforms = render(controller( 'App\\Controller\\AppController::appFooterMenus', {'position': 'platforms'} )) %}

				{{ appFooterFirstMenus|raw }}
				{{ appFooterSecondMenus|raw }}
				{{ appFooterThirdMenus|raw }}
				{{ appFooterPlatforms|raw }}

			</ul>
		</div>
	</div>
</footer>
