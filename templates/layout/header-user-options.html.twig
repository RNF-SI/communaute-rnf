<ul>

    <li><a href="{{ path('user_dashboard') }}">{{ 'pages.user.dashboard.link'|trans }}</a></li>
    <li><a href="{{ path('member', {'user_id':app.user.id}) }}">{{ 'pages.user.profile.link'|trans }}</a></li>
    <li><a href="{{ path('user_groups') }}">{{ 'pages.user.my_groups.link'|trans }}</a></li>
    <li><a href="{{ path('user_discussions') }}">{{ 'pages.user.my_discussions.link'|trans }}</a></li>
    <li>
        <a href="{{ path('messages_index') }}">
            {{ 'pages.messages.link'|trans }}
            {% set waiting = unread_messages() %}
            {% if waiting > 0 %}<span class="notifications-count">{{ waiting }}</span>{% endif %}
        </a>
    </li>
    <li>
        <a href="{{ path('user_notifications') }}">
            {{ 'pages.user.notifications.link'|trans }}
            {% set unread = unread_notifications() %}
            {% if unread > 0 %}<span class="notifications-count">{{ unread }}</span>{% endif %}
        </a>
    </li>
    <li><a href="{{ path('user_parameters_edit') }}">{{ 'pages.user.parameters_edit.link'|trans }}</a></li>
    {% if is_granted('ROLE_ADMIN') %}
        <li><a href="{{ path('administration_platform') }}">{{ 'pages.user.administration_edit.link'|trans }}</a></li>
    {% endif %}
    <li><a href="{{ path('user_logout') }}">{{ 'pages.user.logout.link'|trans }}</a></li>
</ul>
