{{ form_start(form) }}
<div class="form_errors">{{ form_errors(form) }}</div>
<div class="form-row__mandatory">{{ 'forms.mandatory'|trans }}</div>
<div class="form-rows">
    <div class="form-row form-row__field">
        {{ form_label(form.name, 'forms.user.name.label') }}
        {% if form.name.vars.disabled %}
            <div class="hint">{{ 'forms.user.identity_from_rnf'|trans }}</div>
        {% endif %}
        {{ form_widget(form.name, {'attr': {'placeholder': 'forms.user.name.placeholder'}}) }}
        <div class="form_errors">{{ form_errors(form.name) }}</div>
    </div>
    <div class="form-row form-row__field">
        {{ form_label(form.displayname, 'forms.user.display_name.label') }}
        {% if form.displayname.vars.disabled %}
            <div class="hint">{{ 'forms.user.identity_from_rnf'|trans }}</div>
        {% endif %}
        {{ form_widget(form.displayname, {'attr': {'placeholder': 'forms.user.display_name.placeholder'}}) }}
        <div class="form_errors">{{ form_errors(form.displayname) }}</div>
    </div>
    <div class="form-row form-row__file">
        <div class="file-preview">
            <div class="file-preview--img">
                {% if (user is defined) and (user.avatar is not empty) %}
                    <img src="{{ path('member_avatar', {'user_id': user.id}) }}" alt="">
                {% endif %}
            </div>
            <div class="file-preview--content">
                {{ form_label(form.avatarfile, 'forms.user.avatar.label') }}
                <div class="hint">{{ 'forms.user.avatar.hint'|trans|format(form.avatarfile.vars.attr['data-max-size']) }}</div>
                {{ form_widget(form.avatarfile) }}
                {{ form_label(form.avatarfile, 'forms.user.avatar.button', {'label_attr': {'class': 'submit-style submit-style__inverted'}}) }}
                <div class="form_errors">{{ form_errors(form.avatarfile) }}</div>
            </div>
        </div>
    </div>
    <div class="form-row form-row__field">
        {{ form_label(form.jobTitle, 'forms.user.job_title.label') }}
        <div class="hint">{{ 'forms.user.job_title.hint'|trans }}</div>
        {{ form_widget(form.jobTitle, {'attr': {'placeholder': 'forms.user.job_title.placeholder'}}) }}
        <div class="form_errors">{{ form_errors(form.jobTitle) }}</div>
    </div>
    <div class="form-row form-row__field">
        {{ form_label(form.organisation, 'forms.user.organisation.label') }}
        {{ form_widget(form.organisation, {'attr': {'placeholder': 'forms.user.organisation.placeholder'}}) }}
        <div class="form_errors">{{ form_errors(form.organisation) }}</div>
    </div>
    <div class="form-row form-row__field">
        {{ form_label(form.reserves, 'forms.user.reserves.label') }}
        {% if form.reserves.vars.disabled %}
            <div class="hint">{{ 'forms.user.reserves_from_rnf'|trans }}</div>
        {% else %}
            <div class="hint">{{ 'forms.user.reserves.hint'|trans }}</div>
        {% endif %}
        {{ form_widget(form.reserves, {'attr': {'placeholder': 'forms.user.reserves.placeholder'}}) }}
        <div class="form_errors">{{ form_errors(form.reserves) }}</div>
    </div>
    <div class="columns__66-33">
        <div class="form-row form-row__field">
            {{ form_label(form.city, 'forms.user.city.label') }}
            {{ form_widget(form.city, {'attr': {'placeholder': 'forms.user.city.placeholder'}}) }}
            <div class="form_errors">{{ form_errors(form.city) }}</div>
        </div>
        <div class="form-row form-row__field">
            {{ form_label(form.zipcode, 'forms.user.zipcode.label') }}
            {{ form_widget(form.zipcode, {'attr': {'placeholder': 'forms.user.zipcode.placeholder'}}) }}
            <div class="form_errors">{{ form_errors(form.zipcode) }}</div>
        </div>
    </div>
    <div class="form-row form-row__field">
        {{ form_label(form.country, 'forms.user.country.label') }}
        {{ form_widget(form.country, {'attr': {'placeholder': 'forms.user.country.placeholder'}}) }}
        <div class="form_errors">{{ form_errors(form.country) }}</div>
    </div>
    <div class="form-row form-row__field">
        {{ form_label(form.phone, 'forms.user.phone.label') }}
        <div class="hint">{{ 'forms.user.phone.hint'|trans }}</div>
        {{ form_widget(form.phone, {'attr': {'placeholder': 'forms.user.phone.placeholder'}}) }}
        <div class="form_errors">{{ form_errors(form.phone) }}</div>
    </div>
    <div class="form-row form-row__checkbox">
        {{ form_widget(form.emailVisible) }}
        {{ form_label(form.emailVisible, 'forms.user.email_visible.label') }}
        <div class="hint">{{ 'forms.user.email_visible.hint'|trans|format(user.email) }}</div>
        <div class="form_errors">{{ form_errors(form.emailVisible) }}</div>
    </div>
    <div class="form-row form-row__field">
        {{ form_label(form.presentation, 'forms.user.presentation.label') }}
        <div class="hint">{{ 'forms.user.presentation.hint'|trans }}</div>
        {{ form_widget(form.presentation, {'attr': {'placeholder': 'forms.user.presentation.placeholder'}}) }}
        <div class="form_errors">{{ form_errors(form.presentation) }}</div>
    </div>
    <div class="form-row form-row__field">
        {{ form_label(form.skills, 'forms.user.skills.label') }}
        <div class="hint">{{ 'forms.user.skills.hint'|trans }}</div>
        <div class="form-row__checkboxes checkboxes-autocomplete" data-limit="5">
            {{ form_widget(form.skills) }}
        </div>
        <div class="form_errors">{{ form_errors(form.skills) }}</div>
    </div>

    {{ form_widget(form.latitude) }}
    {{ form_widget(form.longitude) }}
</div>
<div class="form-row form-row__submit">
    {{ form_widget(form.submit, {'label': form_submit}) }}
</div>
{{ form_end(form) }}