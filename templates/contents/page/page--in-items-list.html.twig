{% set classes = ['page', 'page__in-items-list', page.isImportant ? 'page__important'] %}
<a class="{{ classes|join(' ') }}" href="{{ path('group_page_index', {'groupSlug': page.usergroup.slug, 'pageSlug': page.slug}) }}">
	{% if page.isImportant %}
		<span class="page-important-badge" title="{{ 'pages.page.is_important'|trans|escape('html_attr') }}">★</span>
	{% endif %}
	{{ page.title }}
</a>
