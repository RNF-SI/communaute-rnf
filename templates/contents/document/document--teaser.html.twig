{% set classes = ['document', 'document__teaser'] %}
<div class="{{ classes|join(' ') }}" data-type="{{ document.file ? (document.file.type|default('')|escape('html_attr')) : '' }}">
	{# Le titre mène à la fiche du document, pas au fichier : c'est là qu'on
	   voit ce qu'il est, ce qui en a été dit, et qu'on peut y renvoyer
	   quelqu'un. Le téléchargement reste à un clic, à côté. (#32) #}
	<a class="document-infos" data-type="{{ document.file ? document.file.type|default('') : '' }}"
	   href="{{ path('group_document_index', {'groupSlug': document.usergroup.slug, 'documentId': document.id}) }}"
	   title="{{ document.title|escape('html_attr') }}">

		<div class="document--icon">
			<span>{{ document.title }}</span>
		</div>

		<div class="document--title">
			<span>{{ document.title }}</span>
			{% if document.description is not empty %}
				<span class="document--description">{{ document.description }}</span>
			{% endif %}
		</div>

		{% if document.tags is not empty %}
			<ul class="tags document--tags">
				{% for tag in document.tags %}
					<li class="tag">{{ tag.name }}</li>
				{% endfor %}
			</ul>
		{% endif %}

		<div class="document--date">
			<span>{{ 'pages.document.view.date'|trans|format(document.createdAt|localizeddate('short', 'none', app.request.locale)) }}</span>
		</div>
	</a>

	{% if document.file %}
		<a class="document--download"
		   href="{{ path('group_document_get', {'groupSlug': document.usergroup.slug, 'documentId': document.id}) }}"
		   title="{{ 'pages.document.view.download'|trans|escape('html_attr') }}"
		   target="_blank">{{ 'pages.document.view.download'|trans }}</a>
	{% endif %}

	{% if is_granted(constant('App\\Security\\GroupDocumentVoter::EDIT'), document) %}
		<div class="in-list-admin-panel">
			<ul>
				<li>
					<a href="{{ path('group_document_edit', {
						'groupSlug':group.slug,
						'documentId':document.id
					}) }}" title="{{ 'pages.document.document_edit.link'|trans|escape('html_attr') }}">
						<span>{{ 'pages.document.document_edit.link'|trans }}</span>
					</a>
				</li>
			</ul>
		</div>
	{% endif %}
</div>
