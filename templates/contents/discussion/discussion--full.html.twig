{% set classes = ['discussion', 'discussion__full'] %}
<div class="{{ classes|join(' ') }}">
	<div class="main--content content-container">
		{% include 'components/app-flashes.html.twig' %}

		<div class="panel">
			<h1 class="h1">{{ discussion.title }}</h1>

			{% set canRename = is_granted(constant('App\\Security\\GroupDiscussionVoter::RENAME'), discussion) %}
			{% if canRename or (membership is defined and membership) %}
				{# Les deux actions partagent une seule colonne : le panneau ne
				   met en page que deux enfants. #}
				<div class="panel--edit discussion-follow">
					{% if canRename %}
						<a class="cta__inverted edit_discussion" href="{{ path('group_discussion_edit', {
							'groupSlug': group.slug,
							'discussionUuid': discussion.uuid
						}) }}">{{ 'pages.discussion.discussion_edit.link'|trans }}</a>
					{% endif %}

					{% if membership is defined and membership %}
						{% set level = membership.getLevelForDiscussion(discussion.uuid) %}
						{% if level == 'none' %}
							<a class="cta__inverted" href="{{ path('group_discussion_follow', {
								'groupSlug': group.slug,
								'discussionUuid': discussion.uuid,
								'level': 'email'
							}) }}">{{ 'pages.discussion.follow.follow'|trans }}</a>
						{% else %}
							<a class="cta__inverted" href="{{ path('group_discussion_follow', {
								'groupSlug': group.slug,
								'discussionUuid': discussion.uuid,
								'level': 'none'
							}) }}">{{ 'pages.discussion.follow.mute'|trans }}</a>
						{% endif %}
					{% endif %}
				</div>
			{% endif %}
		</div>

		{% include 'components/breadcrumb.html.twig' with {'items':[
			{
				label: 'pages.group.groups.title'|trans,
				href: path('groups_index')
			},
			{
				label: group.name,
				href: path('group_index', {'groupSlug':discussion.usergroup.slug})
			},
			{
				label: 'pages.group.discussions.title'|trans,
				href: path('group_discussions_index', {'groupSlug':discussion.usergroup.slug})
			},
			{
				label: discussion.title,
			}
		]} %}

		<section class="messages-list">
			<ul>
				{% for message in discussion.messages %}
					<li>
						{% include 'contents/discussion/message--full.html.twig' with {'message':message} %}
					</li>
				{% endfor %}
			</ul>
		</section>
	</div>
</div>
