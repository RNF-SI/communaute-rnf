{% set classes = ['user', 'user__teaser'] %}
<a class="{{ profileLinkClasses(user.status, classes) }}" href="{{ path('member', {'user_id':user.id}) }}">
	{% include 'contents/user/partials/user--avatar.html.twig' with{'user':user} %}

	<div class="user--infos">
		<div class="user--name">{{ user.name }}</div>
		{% if user.presentation is not empty %}
			<div class="user--presentation">{{ user.presentation }}</div>
		{% endif %}
		{% set job = [] %}
		{% if user.jobTitle is not empty %}{% set job = job|merge([user.jobTitle]) %}{% endif %}
		{% if user.organisation is not empty %}{% set job = job|merge([user.organisation]) %}{% endif %}
		{% if job is not empty %}
			<div class="user--job">{{ job|join(' — ') }}</div>
		{% endif %}
	</div>
</a>
