{% set classes = ['user', 'user__profile'] %}
<div class="{{ classes|join(' ') }}">
	<div class="user-container">
		<div class="panel">
			<div class="user-title">
				{% include 'contents/user/partials/user--avatar.html.twig' with{'user':user, 'filter':'profile'} %}

				<div>
					<h1 class="h2 user--name">{{ user.name }}</h1>

					{% set job = [] %}
					{% if user.jobTitle is not empty %}{% set job = job|merge([user.jobTitle]) %}{% endif %}
					{% if user.organisation is not empty %}{% set job = job|merge([user.organisation]) %}{% endif %}
					{% if job is not empty %}
						<div class="user--job">{{ job|join(' — ') }}</div>
					{% endif %}

					{% set location = [] %}
					{% if user.city is not empty %}{% set location = location|merge([user.city]) %}{% endif %}
					{% if user.country is not empty %}{% set location = location|merge([user.country|countryName]) %}{% endif %}
					{% if location is not empty %}
						<div class="user--location">{{ location|join(', ') }}</div>
					{% endif %}
				</div>
			</div>
			{% if app.user == user %}
				<div class="user-contact">
					<a class="cta" href="{{ path('user_profile_edit') }}">{{ 'pages.user.profile_edit.link'|trans }}</a>
				</div>
			{% else %}
				{# Chacun décide de ce qu'il publie : l'adresse peut être
				   retirée de la fiche, le téléphone n'y figure que s'il a
				   été saisi. (#27) #}
				{% set showEmail = user.emailVisible or app.user.isAdmin %}
				{# Une ligne de pictos plutôt qu'une colonne de boutons : « Écrire »
				   et « Contacter par e-mail » se collaient, l'adresse et « Copier
				   l'adresse » tombaient dessous. Chaque picto porte une légende
				   courte et un nom complet pour les lecteurs d'écran ; l'adresse
				   reste lisible en clair sous la ligne. (#42) #}
				<div class="user-contact">
					{% set canWrite = is_granted(constant('App\\Security\\ConversationVoter::CONTACT'), user) %}
					{% if canWrite or showEmail or user.phone is not empty %}
						<ul class="user-contact--actions">
							{# Écrire par la plateforme : le seul chemin qui marche même
							   quand l'adresse n'est pas publiée. Un vrai lien vers la
							   page, que le dock intercepte quand il est là. #}
							{% if canWrite %}
								<li>
									<a class="contact-action"
									   href="{{ path('messages_new', {'to': user.id}) }}"
									   data-dock-user="{{ user.id }}"
									   data-dock-name="{{ user.name|escape('html_attr') }}"
									   title="{{ 'pages.user.profile.actions.write_title'|trans({'%name%': user.name}) }}">
										<svg aria-hidden="true" focusable="false"><use xlink:href="#chat"/></svg>
										<span class="contact-action--label">{{ 'pages.messages.write_to'|trans }}</span>
									</a>
								</li>
							{% endif %}

							{% if showEmail %}
								<li>
									<a class="contact-action" href="mailto:{{ user.email }}" title="{{ 'pages.user.profile.contact'|trans }} : {{ user.email }}">
										<svg aria-hidden="true" focusable="false"><use xlink:href="#mail"/></svg>
										<span class="contact-action--label">{{ 'pages.user.profile.actions.email'|trans }}</span>
									</a>
								</li>
								<li>
									<button type="button"
											class="contact-action user--email-copy"
											title="{{ 'pages.user.profile.email_copy'|trans }} : {{ user.email }}"
											data-copy-value="{{ user.email }}"
											data-copy-done-label="{{ 'pages.user.profile.email_copied'|trans }}">
										<svg aria-hidden="true" focusable="false"><use xlink:href="#copy"/></svg>
										<span class="contact-action--label" data-copy-label>{{ 'pages.user.profile.actions.copy'|trans }}</span>
									</button>
								</li>
							{% endif %}

							{% if user.phone is not empty %}
								<li class="user--phone">
									<a class="contact-action"
									   href="tel:{{ user.phone|replace({' ': '', '.': '', '-': ''}) }}"
									   title="{{ 'pages.user.profile.actions.phone'|trans }} : {{ user.phone }}">
										<svg aria-hidden="true" focusable="false"><use xlink:href="#phone"/></svg>
										<span class="contact-action--label">{{ user.phone }}</span>
									</a>
								</li>
							{% endif %}
						</ul>
					{% endif %}

					{% if showEmail %}
						<div class="user--email">{{ user.email }}</div>
					{% endif %}

					{% if not canWrite and not user.isMessagesOpen %}
						<div class="hint">{{ 'pages.messages.box_closed'|trans }}</div>
					{% endif %}

					{% if not showEmail and user.phone is empty %}
						<div class="hint">{{ 'pages.user.profile.no_contact'|trans }}</div>
					{% endif %}
				</div>
			{% endif %}
		</div>

		<div class="user--presentation">{{ user.presentation }}</div>

		{% if user.skills is not empty %}
			<div class="user--skills">
				<h2 class="h3">{{ 'pages.member.profile.skills.title'|trans }}&nbsp;:</h2>

				<ul class="tags">
					{% for skill in user.skills %}
						<li class="tag">{{ skill.slug|trans({}, 'skills') }}</li>
					{% endfor %}
				</ul>
			</div>
		{% endif %}

		{% if user.reserves is not empty %}
			<div class="user--reserves">
				<h2 class="h3">{{ 'pages.member.profile.reserves.title'|trans }}&nbsp;:</h2>

				<p>{{ user.reserves }}</p>
			</div>
		{% endif %}
	</div>

	{% if user.usergroupmemberships is not empty %}
		<div class="user--groups">
			<h2 class="h3">{{ 'pages.member.profile.groups.title'|trans }}&nbsp;:</h2>

			<div class="groups-list">
				<ul>
					{% for membership in user.usergroupmemberships %}
						{% if user_group_relation.isMember(user, membership.usergroup) and membership.usergroup.isActive %}
							<li>
								{% include 'contents/group/group--teaser.html.twig' with {'group':membership.usergroup} %}
							</li>
						{% endif %}
					{% endfor %}
				</ul>
			</div>
		</div>
	{% endif %}
</div>
